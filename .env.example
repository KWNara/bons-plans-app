# Crée un projet gratuit sur https://supabase.com puis copie ces valeurs
# depuis Project Settings > API Keys. Renomme ce fichier en .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (jamais NEXT_PUBLIC_, jamais exposée au navigateur).
# Project Settings > API Keys > service_role. Utilisée uniquement par les
# routes API serveur (app/api/**) pour la vérification SIRET des commerçants.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : suivi d'erreurs. Crée un projet gratuit (type Next.js) sur
# https://sentry.io puis colle son DSN ici. Sans cette variable, Sentry
# reste désactivé silencieusement (aucune erreur, aucun code à changer).
NEXT_PUBLIC_SENTRY_DSN=
